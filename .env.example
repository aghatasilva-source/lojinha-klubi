APP_ENV=desenvolvimento
DATABASE_PATH=./backend/data/lojinha.db
# No servidor: 0.0.0.0, ou mantenha 127.0.0.1 se houver proxy reverso (nginx, IIS etc.) na frente
API_HOST=127.0.0.1
API_PORT=8000
# Endereço público da interface. Também libera o CORS para esse site.
FRONTEND_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=seu-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_WORKSPACE_DOMAIN=example.com
ADMIN_EMAILS=admin@example.com
CLERK_SECRET_KEY=sk_test_cole_a_secret_key_do_clerk_aqui
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000
CLERK_WORKSPACE_DOMAIN=example.com
GOOGLE_SERVICE_ACCOUNT_FILE=./sheets.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_GID=0
GOOGLE_SHEET_NAME=Pedidos
ESTOQUE_XLSX=./CONTROLE DE ESTOQUE .xlsx
PEDIDOS_CONCLUIDOS_XLSX=./PEDIDOS CONCLUIDOS - 2026.xlsx
TIMEZONE=America/Sao_Paulo
STOCK_LOW_LIMIT=20
CLOSING_DAY=30
ADMIN_TOKEN=
OPERACAO_TOKEN=
CONSULTA_TOKEN=
# Pasta das fotos dos produtos enviadas pelo painel (faça backup junto com o banco)
IMAGES_DIR=./backend/data/imagens
